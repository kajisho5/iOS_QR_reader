    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードとバーコードを読み取るためにカメラを使用します。読み取った内容が外部に送信されることはありません"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った連絡先を連絡先アプリに追加するために使用します"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴のロックを解除するために Face ID を使います。顔のデータがアプリに渡ることはありません"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「地図の位置」のQRコードに現在地を入れるために使います。位置情報が外部に送信されることはありません"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したQRコードの画像を写真ライブラリに保存するために使用します"
          }
        }
      }
    }
  },
  "version": "1.0"
